# ─────────────────────────────────────────────────────────────────────────────
# 2K SHOP — variables d'environnement
# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
# Dev  : SQLite, simple fichier local (aucun serveur à installer).
# Prod : PostgreSQL (Neon, Supabase…), ex. :
#        DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# ── Authentification admin (NextAuth) ────────────────────────────────────────
# Secret de signature des sessions. En générer un avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET="a-remplacer-par-un-secret-aleatoire-genere"
# URL publique de l'application (sans slash final).
NEXTAUTH_URL="http://localhost:3000"

# ── Compte admin créé par le seed (`npm run db:seed`) ────────────────────────
ADMIN_EMAIL="admin@2kshop.gn"
ADMIN_PASSWORD="changeme"

# ── Site public ──────────────────────────────────────────────────────────────
# Sert de base aux URLs absolues (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Numéro WhatsApp de la boutique, au format international SANS le "+".
# Ex. pour +224 620 12 34 56 -> 224620123456
NEXT_PUBLIC_WHATSAPP_NUMBER="224600000000"
