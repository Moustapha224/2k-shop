# ─────────────────────────────────────────────────────────────────────────────
# 2K SHOP — variables d'environnement
# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
# Dev  : SQLite, simple fichier local (aucun serveur à installer).
# Prod : PostgreSQL (Neon, Supabase…), ex. :
#        DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# ── Authentification admin (NextAuth) ────────────────────────────────────────
# Secret de signature des sessions. En générer un avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET="a-remplacer-par-un-secret-aleatoire-genere"
# URL publique de l'application (sans slash final).
NEXTAUTH_URL="http://localhost:3000"

# ── Compte admin créé / mis à jour par le seed (`npm run db:seed`) ───────────
# Le seed met à jour le mot de passe à chaque exécution.
ADMIN_EMAIL="admin@exemple.gn"
ADMIN_PASSWORD="a-remplacer"

# ── Site public ──────────────────────────────────────────────────────────────
# Sert de base aux URLs absolues (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Numéro WhatsApp de la boutique, au format international SANS le "+".
# Ex. pour +224 620 12 34 56 -> 224620123456
NEXT_PUBLIC_WHATSAPP_NUMBER="224600000000"

# (Optionnel) Lien de contact WhatsApp Business à message pré-rempli.
# Si renseigné, prioritaire sur NEXT_PUBLIC_WHATSAPP_NUMBER pour le bouton
# flottant et le lien du footer.
# NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/message/XXXXXXXXXXX"

# (Optionnel) Page Facebook de la boutique — affichée dans le footer.
# NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/..."
