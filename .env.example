# ─────────────────────────────────────────────────────────────────────────────
# 2K SHOP — variables d'environnement
# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL / Neon) ──────────────────────────────────────
# Créer un projet sur https://neon.com puis copier la chaîne de connexion
# (Dashboard → Connect → "Connection string"). Elle ressemble à :
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
#
# Prendre la chaîne AVEC pooling (l'hôte contient "-pooler") : en serverless,
# chaque invocation ouvre sinon une connexion de plus jusqu'à saturation.
#
# Pour du développement local, une base Neon séparée évite de travailler
# directement sur les données de production.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/2kshop?sslmode=require"

# ── Authentification admin (NextAuth) ────────────────────────────────────────
# Secret de signature des sessions. En générer un avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET="a-remplacer-par-un-secret-aleatoire-genere"
# URL publique de l'application (sans slash final).
NEXTAUTH_URL="http://localhost:3000"

# ── Compte admin créé / mis à jour par le seed (`npm run db:seed`) ───────────
# Le seed met à jour le mot de passe à chaque exécution.
ADMIN_EMAIL="admin@exemple.gn"
ADMIN_PASSWORD="a-remplacer"

# ── Site public ──────────────────────────────────────────────────────────────
# Sert de base aux URLs absolues (Open Graph, sitemap, liens des emails).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Numéro WhatsApp de la boutique, au format international SANS le "+".
# Ex. pour +224 620 12 34 56 -> 224620123456
NEXT_PUBLIC_WHATSAPP_NUMBER="224600000000"

# (Optionnel) Lien de contact WhatsApp Business à message pré-rempli.
# Si renseigné, prioritaire sur NEXT_PUBLIC_WHATSAPP_NUMBER pour le bouton
# flottant et le lien du footer.
# NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/message/XXXXXXXXXXX"

# (Optionnel) Page Facebook de la boutique — affichée dans le footer.
# NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/..."

# ── Notifications email au propriétaire (Resend) ─────────────────────────────
# Créer un compte gratuit sur https://resend.com (100 emails/jour offerts),
# puis copier la clé API. Tant que cette variable est vide, les notifications
# de commande sont silencieusement désactivées et le site continue à fonctionner.
RESEND_API_KEY=""

# Destinataire des notifications (nouvelles commandes). Repli sur ADMIN_EMAIL.
# NOTIFICATION_EMAIL="proprietaire@exemple.gn"

# Adresse d'expédition. Par défaut, la sandbox Resend fonctionne sans domaine
# vérifié mais ne peut envoyer qu'à l'adresse du propriétaire du compte Resend.
# En production, vérifier un domaine sur Resend puis mettre :
#   EMAIL_FROM="2K SHOP <commandes@votre-domaine.gn>"
EMAIL_FROM="2K SHOP <onboarding@resend.dev>"

# ── Stockage des images admin (Neon Object Storage, compatible S3) ───────────
# OBLIGATOIRE en production : le systeme de fichiers de Vercel est en lecture
# seule, un upload admin y echoue. Tant que ces variables sont absentes, les
# images sont ecrites dans public/uploads/ — pratique en local, inutilisable
# une fois deploye.
#
# Mise en place : console Neon -> Object storage -> New bucket.
# Choisir l'acces "public_read" : un bucket prive imposerait des URLs signees
# a duree limitee, qui expireraient alors qu'elles sont stockees en base.
STORAGE_BUCKET="2kshop-media"
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.c-5.eu-central-1.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
