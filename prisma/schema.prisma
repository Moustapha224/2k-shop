// Schema Prisma — 2K SHOP
// La connexion (DATABASE_URL) est configuree dans prisma.config.ts (Prisma 7),
// pas dans ce fichier.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Categorie de produits (Hauts, Pantalons, Chaussures...).
model Categorie {
  id    String @id @default(cuid())
  nom   String
  slug  String @unique
  ordre Int    @default(0)

  produits Produit[]
}

/// VETEMENT -> tailles S/M/L/XL/XXL, CHAUSSURE -> pointures 38-46.
/// Voir TAILLES_VETEMENT / TAILLES_CHAUSSURE dans lib/constants.ts.
model Produit {
  id          String  @id @default(cuid())
  nom         String
  slug        String  @unique
  description String
  prix        Int
  type        String
  actif       Boolean @default(true)

  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  images    ProduitImage[]
  variantes Variante[]
  lignes    LigneCommande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorieId])
}

model ProduitImage {
  id        String @id @default(cuid())
  url       String
  ordre     Int    @default(0)
  produitId String

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@index([produitId])
}

/// Une ligne de stock par (produit, taille).
model Variante {
  id        String @id @default(cuid())
  taille    String
  stock     Int    @default(0)
  produitId String

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@unique([produitId, taille])
}

/// Communes de Conakry desservies, avec frais de livraison propres.
model Commune {
  id             String  @id @default(cuid())
  nom            String  @unique
  fraisLivraison Int
  actif          Boolean @default(true)

  commandes Commande[]
}

/// Statuts alignes sur STATUTS_COMMANDE (lib/constants.ts) : SQLite ne
/// supporte pas les enums Prisma, la valeur est validee cote Zod.
model Commande {
  id     String @id @default(cuid())
  numero String @unique

  statut String @default("EN_ATTENTE")

  clientNom       String
  clientTelephone String
  /// Optionnel : renseigne uniquement si le client veut une confirmation par
  /// email. Le telephone reste l'identifiant de suivi.
  clientEmail     String?

  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier  String
  adresse   String
  notes     String?

  sousTotal      Int
  fraisLivraison Int
  total          Int

  confirmeeLe    DateTime?
  enLivraisonLe  DateTime?
  livreeLe       DateTime?

  lignes LigneCommande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([clientTelephone])
}

/// Ligne de commande : les champs produit/prix sont dupliques (snapshot) pour
/// que la commande reste correcte meme si le produit change ou est supprime.
model LigneCommande {
  id         String  @id @default(cuid())
  commandeId String
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  produitId String?
  produit   Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)

  nomProduit    String
  taille        String
  prixUnitaire  Int
  quantite      Int
  sousTotal     Int
}

model Admin {
  id             String @id @default(cuid())
  email          String @unique
  motDePasseHash String
  nom            String

  createdAt DateTime @default(now())
}

/// Slide du carrousel hero de la page d'accueil.
/// imageUrl : chemin relatif dans /public (ex: /uploads/slides/xxx.jpg).
/// imageUrlExterne : URL externe (Unsplash, CDN…) si pas d'upload local.
/// ordre : ordre d'affichage (croissant).
model SlideHero {
  id              String  @id @default(cuid())
  titre           String?
  sousTitre       String?
  imageUrl        String?
  imageUrlExterne String?
  ordre           Int     @default(0)
  actif           Boolean @default(true)

  createdAt DateTime @default(now())
}

/// Reglages de la boutique — une seule ligne (id fixe "principal").
model Parametre {
  id              String   @id @default("principal")
  whatsapp        String?
  /// URL complete WhatsApp (ex : lien wa.me/message/XXX a message pre-rempli).
  /// Si renseignee, prioritaire sur `whatsapp` pour le bouton flottant.
  whatsappUrl     String?
  /// Page Facebook de la boutique.
  facebookUrl     String?
  messageAnnonce  String?
  updatedAt       DateTime @updatedAt
}

/// Inscription a la newsletter (formulaire du footer).
/// `email` est stocke en minuscules pour que l'unicite soit reellement
/// insensible a la casse : SQLite compare @unique octet par octet.
model AbonneNewsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  actif     Boolean  @default(true)

  createdAt DateTime @default(now())
}
